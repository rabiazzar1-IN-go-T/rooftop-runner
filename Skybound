  update(dist, lod, frC, frS, behind) {
    const fA = this.far.instanceMatrix.array, cap = this.cap; let nn = 0, nf = 0;
    const tw = frS ? this.twins : null, tN = this.near.length;
    if (tw) tw.forEach((t) => t.begin());
    for (const it of this.items) {
      const isFar = it.d - dist > lod;
      _wSph.center.copy(it.c); _wSph.radius = it.r;
      if (frC.intersectsSphere(_wSph)) {
        if (isFar) { if (nf < cap) fA.set(it.e, (nf++) * 16); }
        else if (nn < cap) { for (let k = 0; k < tN; k++) this.near[k].instanceMatrix.array.set(it.e, nn * 16); nn++; }
      }
      if (tw && it.cast && (!frS.planes || frS.intersectsSphere(_wSph))) {
        if (isFar || tw.length === 1 || World.optBoxShadow) tw[tw.length - 1].push(it.e, 0); else for (let k = 0; k < tN; k++) tw[k].push(it.e, 0);
      }
    }
    for (const m of this.near) { m.count = nn; m.visible = nn > 0; if (nn) uploadRange(m.instanceMatrix, nn * 16); }
    this.far.count = nf; this.far.visible = nf > 0; if (nf) uploadRange(this.far.instanceMatrix, nf * 16);
    if (tw) tw.forEach((t) => t.end(behind));
  }
}

