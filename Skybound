    slide(v, t) {
      const d = 0.5, env = gain(v, 0);
      env.gain.setValueAtTime(0, t);
      env.gain.linearRampToValueAtTime(1, t + 0.035);
      env.gain.setValueAtTime(1, t + d - 0.18);
      env.gain.linearRampToValueAtTime(0, t + d);
      env.connect(v.out);
      const bp = filt(v, 'bandpass', 1700, 1.3); // gritty tile scrape
      bp.frequency.setValueAtTime(1700, t);
      bp.frequency.exponentialRampToValueAtTime(900, t + d);
      const gc = gain(v, 0); crackle(gc.gain, t, d, 140, 1, 0.006, 0.4);
