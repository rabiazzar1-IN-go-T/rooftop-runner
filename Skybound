        '\nvec4 wH4(vec2 i){ vec4 x = fract(vec4(i.x, i.x + 1.0, i.x, i.x + 1.0) * 0.1031), y = fract(vec4(i.y, i.y, i.y + 1.0, i.y + 1.0) * 0.1031);' +
