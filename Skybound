    const farMat = patchMaterial(new THREE.MeshStandardMaterial({ map: imp.color, roughnessMap: imp.arm, metalnessMap: imp.arm,
      color: mat0 && mat0.color ? mat0.color.clone() : new THREE.Color(1, 1, 1), roughness: mat0 ? mat0.roughness : 0.9, metalness: mat0 ? mat0.metalness : 0 }), { key: 'far' + kind });
