    },
    land(v, t) {
      let g = gain(v, 0), e = perc(g.gain, t, 0.003, 0.6, 0.26);
      let x = osc(v, 'sine', 130, t, e); glide(x.frequency, t, 130, 46, 0.14); link(x, g, v.out);
      g = gain(v, 0); e = perc(g.gain, t, 0.002, 0.4, 0.1);
