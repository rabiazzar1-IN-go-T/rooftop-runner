    },
    gear(v, t, o) {
      const st = cl(Math.round(+o.streak || 0), 0, 20), idx = Math.min(st, 10);
      const f = mtof(GEAR_PENT[idx % 5] + 12 * Math.floor(idx / 5)), out = pan(v, rv(-0.2, 0.2));
      out.connect(v.out);
