                shopW = isShop * step( abs( f.x - 0.5 ), 0.4 ) * step( 0.1, f.y ) * step( f.y, 0.72 );
                door = ( 1.0 - isShop ) * step( abs( f.x - 0.5 ), 0.14 ) * step( f.y, 0.7 );
