      hold(tr.bus.gain, t); tr.bus.gain.setTargetAtTime(1, t, XF / 4.5);
      hold(tr.revS.gain, t); tr.revS.gain.setTargetAtTime(tr.rev, t, XF / 4.5);
    }
    startTimer();
  }

  // =====================================================================
  // SFX
  // =====================================================================
  const GEAR_PENT = [69, 72, 74, 77, 79]; // A C D F G, sits on the run track's D minor
  const SFX = {
    step(v, t, o) {
      const s = o.surface, k = rv(0.9, 1.1), out = pan(v, rv(-0.15, 0.15));
      out.connect(v.out);
      let g, e, x;
      if (s === 'wood') { // hollow knock
        g = gain(v, 0); e = perc(g.gain, t, 0.002, 0.6, 0.1);
        x = osc(v, 'sine', 270 * k, t, e); glide(x.frequency, t, 270 * k, 190 * k, 0.06); link(x, g, out);
        g = gain(v, 0); e = perc(g.gain, t, 0.001, 0.18, 0.05);
        link(osc(v, 'triangle', 590 * k, t, e), g, out);
        g = gain(v, 0); e = perc(g.gain, t, 0.001, 0.45, 0.04);
        link(noise(v, t, e), filt(v, 'bandpass', 950 * k, 2.5), g, out);
      } else if (s === 'metal') { // short clang ring
        const f = 640 * k;
        for (const p of [[1, 0.15, 0.3], [2.43, 0.09, 0.18], [3.96, 0.05, 0.1]]) {
          g = gain(v, 0); e = perc(g.gain, t, 0.001, p[1], p[2]);
          link(osc(v, 'sine', f * p[0], t, e), g, out);
        }
        g = gain(v, 0); e = perc(g.gain, t, 0.0008, 0.22, 0.018);
        link(noise(v, t, e), filt(v, 'highpass', 2200, 0.7), g, out);
        g = gain(v, 0); e = perc(g.gain, t, 0.002, 0.28, 0.06);
        x = osc(v, 'sine', 120 * k, t, e); glide(x.frequency, t, 120 * k, 62, 0.05); link(x, g, out);
      } else { // slate tile: crisp clack + low thud
        g = gain(v, 0); e = perc(g.gain, t, 0.0008, 0.9, 0.07);
        link(noise(v, t, e), filt(v, 'bandpass', 2600 * k, 1.4), g, out);
        g = gain(v, 0); e = perc(g.gain, t, 0.0008, 0.14, 0.06);
        link(osc(v, 'triangle', 1700 * k, t, e), g, out);
        g = gain(v, 0); e = perc(g.gain, t, 0.001, 0.6, 0.08);
        link(noise(v, t, e), filt(v, 'bandpass', 650 * k, 1.2), g, out);
        g = gain(v, 0); e = perc(g.gain, t, 0.003, 0.4, 0.085);
        x = osc(v, 'sine', 150 * k, t, e); glide(x.frequency, t, 150 * k, 58, 0.06); link(x, g, out);
      }
    },
    jump(v, t) {
      const k = rv(0.94, 1.06);
      let g = gain(v, 0), e = perc(g.gain, t, 0.05, 0.75, 0.2);
      const bp = filt(v, 'bandpass', 450, 0.9);
      bp.frequency.setValueAtTime(450, t);
      bp.frequency.exponentialRampToValueAtTime(1800 * k, t + 0.14);
      bp.frequency.exponentialRampToValueAtTime(800, t + 0.3);
      link(noise(v, t, e), bp, g, v.out);
      const tb = t + 0.01; // soft "hup": voiced saw through two formants + breath
      g = gain(v, 0); e = perc(g.gain, tb, 0.02, 0.5, 0.12);
      const vo = osc(v, 'sawtooth', 160 * k, tb, e); glide(vo.frequency, tb, 160 * k, 115 * k, 0.13);
      const f1 = filt(v, 'bandpass', 620, 4), f2 = filt(v, 'bandpass', 1150, 5);
