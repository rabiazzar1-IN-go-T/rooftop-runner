<script>
// Until the game has started: a failure (no WebGL 2, a script error) shows a readable message instead of an endless loading bar
(function () {
  function fail(msg) {
    if (window.__booted || window.__bootFailed) return;
    window.__bootFailed = true;
    var l = document.getElementById('loading'); if (!l) return;
    l.innerHTML = '';
    var d = document.createElement('div'); d.className = 'lfail';
    d.textContent = 'Could not start the 3D graphics (' + msg + '). Update Chrome, close other apps, then open the game again.';
    l.appendChild(d);
  }
  window.__bootFail = fail;
  addEventListener('error', function (e) { if (e && e.message) fail(e.message); });
  addEventListener('unhandledrejection', function (e) { var r = e && e.reason; fail(r && r.message ? r.message : String(r)); });
  setTimeout(function () {
    if (window.__booted || window.__bootFailed) return;
    var t = document.getElementById('loadtxt'); if (t) t.textContent = 'Still loading... (close other apps if this takes long)';
  }, 90000);
})();
</script>

