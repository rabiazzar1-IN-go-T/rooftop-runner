        at.needsUpdate = true;
      }
      this.lo = this.max; this.hi = -1;
      this.dirty = false;
    }
  }
}

// Ambient floating motes (sun dust / embers / fireflies): fully procedural, zero CPU per frame.
class Motes {
  constructor({ count = 260, box = [18, 9, 40], color = [3.0, 1.7, 0.8], size = 0.06, drift = [0.15, 0.25, 0.0], twinkle = 1.0 }) {
    const g = new THREE.BufferGeometry();
    const seeds = new Float32Array(count * 3), w = new Float32Array(count);
    for (let i = 0; i < count; i++) { seeds[i * 3] = rnd(); seeds[i * 3 + 1] = rnd(); seeds[i * 3 + 2] = rnd(); w[i] = rnd(); }
    g.setAttribute('position', new THREE.BufferAttribute(seeds, 3));
    g.setAttribute('aW', new THREE.BufferAttribute(w, 1));
    this.mat = new THREE.ShaderMaterial({
      transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
      uniforms: { uTime: { value: 0 }, uScroll: { value: 0 }, uCenter: { value: new THREE.Vector3() }, uBox: { value: new THREE.Vector3(...box) },
        uDrift: { value: new THREE.Vector3(...drift) }, uColor: { value: new THREE.Color(...color) }, uSize: { value: size }, uScale: { value: 400 },
        uTw: { value: twinkle }, uAmount: { value: 1 } },
      vertexShader: `attribute float aW; uniform float uTime, uScroll, uSize, uScale; uniform vec3 uCenter, uBox, uDrift; varying float vA; uniform float uTw, uAmount;
