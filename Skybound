              float streak = step( wx, 0.15 ) * step( f.y, 0.15 ) * ( 0.5 + 0.5 * wHash( vec2( floor( f.x * 30.0 ), cell.x ) ) ) * floorOk;
              // street level: wide shop window or a wooden door
              float shopW = 0.0, door = 0.0;
