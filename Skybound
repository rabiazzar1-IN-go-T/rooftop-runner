// Falling autumn leaves around the camera: procedural, tumbling, zero CPU per frame.
class Leaves {
  constructor(count, tex) {
    const g = new THREE.BufferGeometry(); const s = new Float32Array(count * 3), w = new Float32Array(count), c = new Float32Array(count * 3);
    const pal = [[0.62, 0.12, 0.05], [0.8, 0.3, 0.07], [0.85, 0.5, 0.12], [0.5, 0.1, 0.06], [0.7, 0.42, 0.1]];
    for (let i = 0; i < count; i++) { s[i * 3] = rnd(); s[i * 3 + 1] = rnd(); s[i * 3 + 2] = rnd(); w[i] = rnd(); const p = pal[(rnd() * pal.length) | 0]; c[i * 3] = p[0]; c[i * 3 + 1] = p[1]; c[i * 3 + 2] = p[2]; }
    g.setAttribute('position', new THREE.BufferAttribute(s, 3)); g.setAttribute('aW', new THREE.BufferAttribute(w, 1)); g.setAttribute('aC', new THREE.BufferAttribute(c, 3));
    this.mat = new THREE.ShaderMaterial({ transparent: false, depthWrite: true, alphaTest: 0.5,
      uniforms: { map: { value: tex }, uTime: { value: 0 }, uScroll: { value: 0 }, uCenter: { value: new THREE.Vector3() }, uBox: { value: new THREE.Vector3(16, 9, 44) }, uScale: { value: 400 },
        uSun: { value: new THREE.Color(1.4, 0.8, 0.45) }, uFog: { value: new THREE.Color() } },
      vertexShader: `attribute float aW; attribute vec3 aC; uniform float uTime, uScroll, uScale; uniform vec3 uCenter, uBox; varying vec3 vC; varying float vRot; varying float vFlip;
        void main(){
          vec3 l = position * uBox + vec3(-0.9 - aW * 0.6, -0.55 - aW * 0.5, 0.0) * uTime + vec3(sin(uTime * (0.8 + aW) + aW * 40.0) * 0.8, 0.0, uScroll + uTime * 2.0);
          l = mod(l, uBox) - uBox * 0.5; l.y += uBox.y * 0.15;
          vec4 mv = viewMatrix * vec4(uCenter + l, 1.0); gl_Position = projectionMatrix * mv;
          gl_PointSize = clamp(0.2 * uScale / max(-mv.z, 0.1), 2.0, 64.0);
          vC = aC * (0.8 + 0.4 * aW); vRot = uTime * (1.5 + aW * 3.0) + aW * 20.0; vFlip = abs(sin(uTime * (2.0 + aW * 2.0) + aW * 9.0));
        }`,
      fragmentShader: `uniform sampler2D map; uniform vec3 uSun; varying vec3 vC; varying float vRot; varying float vFlip;
        void main(){ vec2 p = gl_PointCoord - 0.5; p.x /= max(vFlip, 0.15); float cs = cos(vRot), sn = sin(vRot);
