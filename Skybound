// stone faces dropping from the edges of a 2 m wide, 1 m long slab (fork bridges: stretched to width and length)
function slabFacesGeo() {
  const pts = [[-1, 0], [1, 0], [1, -1], [-1, -1]], stone = [];
  for (let i = 0; i < pts.length; i++) {
    const a = pts[i], b = pts[(i + 1) % pts.length];
