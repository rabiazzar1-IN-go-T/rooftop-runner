              wp = instanceMatrix * wp;
              wn = wim * ( wn / vec3( dot( wim[ 0 ], wim[ 0 ] ), dot( wim[ 1 ], wim[ 1 ] ), dot( wim[ 2 ], wim[ 2 ] ) ) );
            #endif
            wp = uGroupInv * ( modelMatrix * wp ); wn = normalize( mat3( uGroupInv ) * normalize( mat3( modelMatrix ) * wn ) );
            vWPos = wp.xyz; vWNrm = wn;
