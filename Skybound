    // ---- the distant battle (quiet: it is 300-1000 m away; opts.vol 0..1 scales it, opts.pan places it, default right) ----
    horn(v, t, o) { // the walker's steam horn: a deep minor chord that sags in as the valve opens, wavers, and dies with the pressure
      const vol = cl(o.vol == null ? 1 : +o.vol, 0, 1), d = 1.55, end = t + d + 0.35;
