    if (!ok || name === curMusic) return;
    const t = ctx.currentTime;
    if (curMusic) {
      const o = tracks[curMusic];
      hold(o.bus.gain, t); o.bus.gain.linearRampToValueAtTime(0, t + XF);
      hold(o.revS.gain, t); o.revS.gain.linearRampToValueAtTime(0, t + XF);
      o.stopAt = t + XF + 0.15;
    }
    curMusic = name;
    if (name) {
      const tr = tracks[name];
      if (!tr.active) { tr.active = true; tr.step = 0; tr.next = t + 0.08; tr.S = null; tr.V = null; tr.lastBreak = 0; }
