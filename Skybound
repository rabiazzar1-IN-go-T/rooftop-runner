        .replace('#include <common>', '#include <common>\nuniform vec3 uRimColor; uniform vec3 uSunDirView; uniform float uRimStrength;')
        .replace('#include <opaque_fragment>', `{
          vec3 rimV = normalize( vViewPosition );
