      sh.vertexShader = sh.vertexShader
        .replace('#include <common>', '#include <common>\nuniform mat4 uGroupInv; uniform float uUVScale; varying vec2 vWUV; varying vec3 vWPos; varying vec3 vWNrm;')
        .replace('#include <uv_vertex>', `#include <uv_vertex>
          {
            vec4 wp = vec4( position, 1.0 );
