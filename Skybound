    const s = imp.box.getSize(_wV1); this.ctr = imp.c.clone(); this.rad = s.length() / 2 + 0.05;
    // shadows are cast by the stand-in at every distance: the model's own box gives the same shadow at the shadow
    // map's 2-3 cm texels (measured: 13-42 pixels differ on high), for 12 triangles instead of 5,000. (boxShadow
    // false would cast the full model up close.)
    this.twins = !Q.shadows ? [] : QW.boxShadow ? [new ShadowTwin(this.far, cap)] : [...this.near, this.far].map((m) => new ShadowTwin(m, cap));
    this.meshes = [...this.near, this.far, ...this.twins.map((t) => t.mesh)];
