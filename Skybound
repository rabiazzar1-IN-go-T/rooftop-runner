  pushQuad(stone, [-ROAD_HALF, 0, ex], [-ROAD_HALF, -45, ex], [BRIDGE_X, -45, ex], [BRIDGE_X, 0, ex]);
  pushQuad(stone, [BRIDGE_X, 0, -L - ex], [BRIDGE_X, -45, -L - ex], [-ROAD_HALF, -45, -L - ex], [-ROAD_HALF, 0, -L - ex]);
  const rail = [boxGeo(0.52, 0.2, L, RAIL_X, 1.15, -L / 2), boxGeo(0.5, 0.16, L, RAIL_X, 0.18, -L / 2), boxGeo(0.3, 0.06, L, BRIDGE_X + 0.12, 0.08, -L / 2)];
