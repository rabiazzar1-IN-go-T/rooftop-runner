  pushQuad(stone, [-ROAD_HALF, 0, ex], [-ROAD_HALF, 0.16, ex], [-ROAD_HALF, 0.16, -L - ex], [-ROAD_HALF, 0, -L - ex]); // kerb face
  pushQuad(stone, [ROAD_HALF, 0.1, ex], [ROAD_HALF, 0, ex], [ROAD_HALF, 0, -L - ex], [ROAD_HALF, 0.1, -L - ex]);
