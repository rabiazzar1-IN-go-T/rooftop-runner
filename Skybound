// ---------- GPU particles: CPU only writes on spawn; motion/fade computed in the vertex shader ----------
const NOISE_GLSL = `
float pN(vec2 p){ vec2 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
  float a=fract(sin(dot(i,vec2(127.1,311.7)))*43758.5453), b=fract(sin(dot(i+vec2(1,0),vec2(127.1,311.7)))*43758.5453);
  float c=fract(sin(dot(i+vec2(0,1),vec2(127.1,311.7)))*43758.5453), d=fract(sin(dot(i+vec2(1,1),vec2(127.1,311.7)))*43758.5453);
  return mix(mix(a,b,f.x),mix(c,d,f.x),f.y); }`;

class Particles {
  // kind: 'smoke' (soft lit puffs, normal blend) | 'glow' (additive sparks/embers)
  constructor({ max = 400, kind = 'smoke', c0, c1, gravity = [0, 0, 0], drag = 0.0, map = null, fogFade = 0.004 }) {
    this.max = max; this.i = 0; this.dirty = false;
    const g = new THREE.BufferGeometry();
    this.pos = new Float32Array(max * 3); this.vel = new Float32Array(max * 3);
    this.tl = new Float32Array(max * 2); this.sz = new Float32Array(max * 3);
    for (let k = 0; k < max; k++) { this.tl[k * 2] = -1e6; this.tl[k * 2 + 1] = 1; }
    g.setAttribute('position', new THREE.BufferAttribute(this.pos, 3).setUsage(THREE.DynamicDrawUsage));
    g.setAttribute('aV', new THREE.BufferAttribute(this.vel, 3).setUsage(THREE.DynamicDrawUsage));
    g.setAttribute('aT', new THREE.BufferAttribute(this.tl, 2).setUsage(THREE.DynamicDrawUsage));
    g.setAttribute('aS', new THREE.BufferAttribute(this.sz, 3).setUsage(THREE.DynamicDrawUsage));
    const glow = kind === 'glow';
    this.mat = new THREE.ShaderMaterial({
      transparent: true, depthWrite: false, depthTest: true,
      blending: glow ? THREE.AdditiveBlending : THREE.NormalBlending,
      uniforms: {
        uTime: { value: 0 }, uScale: { value: 400 }, uGrav: { value: new THREE.Vector3(...gravity) }, uDrag: { value: drag },
        uC0: { value: new THREE.Vector4(...(c0 || [1, 1, 1, 1])) }, uC1: { value: new THREE.Vector4(...(c1 || [1, 1, 1, 0])) },
        map: { value: map }, uUseMap: { value: map ? 1 : 0 }, uFogFade: { value: fogFade },
        fogColor: { value: new THREE.Color() }, uSunDir: U.uSunDir, uSunFogColor: U.uSunFogColor,
      },
      vertexShader: `attribute vec3 aV; attribute vec2 aT; attribute vec3 aS;
        uniform float uTime, uScale, uDrag, uFogFade; uniform vec3 uGrav;
        varying float vAge; varying float vSeed; varying float vFog; varying vec3 vDir;
        void main(){
          float t = uTime - aT.x; float age = t / aT.y;
          if (age < 0.0 || age > 1.0) { gl_Position = vec4(2.0, 2.0, 2.0, 1.0); gl_PointSize = 0.0; vAge = 2.0; return; }
          float disp = uDrag > 0.001 ? (1.0 - exp(-uDrag * t)) / uDrag : t;
          vec3 p = position + aV * disp + 0.5 * uGrav * t * t;
          vec4 wp = modelMatrix * vec4(p, 1.0);
          vec4 mv = viewMatrix * wp;
          gl_Position = projectionMatrix * mv;
          gl_PointSize = min(mix(aS.x, aS.y, age) * uScale / max(-mv.z, 0.1), 600.0);
          vAge = age; vSeed = aS.z;
          float d = length(wp.xyz - cameraPosition); vDir = (wp.xyz - cameraPosition) / max(d, 0.001);
          vFog = 1.0 - exp(-d * uFogFade);
        }`,
      fragmentShader: `uniform vec4 uC0, uC1; uniform sampler2D map; uniform float uUseMap; uniform vec3 fogColor, uSunDir, uSunFogColor;
        varying float vAge; varying float vSeed; varying float vFog; varying vec3 vDir;
        ${NOISE_GLSL}
        void main(){
          if (vAge > 1.0) discard;
          vec2 pc = gl_PointCoord - 0.5;
          float an = vSeed * 6.2831 + vAge * (vSeed - 0.5) * 2.5; float cs = cos(an), sn = sin(an);
          vec2 r = vec2(cs * pc.x - sn * pc.y, sn * pc.x + cs * pc.y);
          float m;
          if (uUseMap > 0.5) { vec4 tx = texture2D(map, r + 0.5); m = tx.a * dot(tx.rgb, vec3(0.333)); }
          else {
            float rl = length(r);
            ${glow ? 'm = pow(smoothstep(0.5, 0.0, rl), 2.2);' : 'm = smoothstep(0.5, 0.12, rl) * (0.55 + 0.45 * pN(r * 5.0 + vSeed * 17.0)) * (0.7 + 0.3 * pN(r * 11.0 - vSeed * 9.0));'}
          }
          vec4 c = mix(uC0, uC1, vAge);
          float fade = smoothstep(0.0, ${glow ? '0.05' : '0.14'}, vAge) * (1.0 - smoothstep(0.55, 1.0, vAge));
          vec3 col = c.rgb;
          ${glow ? '' : 'float sunA = pow(max(dot(vDir, uSunDir), 0.0), 4.0); col += uSunFogColor * 0.35 * sunA; col = mix(col, mix(fogColor, uSunFogColor, sunA), vFog);'}
          ${glow ? 'col *= (1.0 - vFog);' : ''}
          gl_FragColor = vec4(col, c.a * m * fade);
          #include <tonemapping_fragment>
          #include <colorspace_fragment>
        }`,
    });
    this.points = new THREE.Points(g, this.mat);
    this.points.frustumCulled = false;
    this.points.renderOrder = glow ? 3 : 2;
    this.geo = g;
    // phone speed: a system with nothing alive is not drawn at all (most of the time sparks, dust and chimney smoke
    // are empty), and only the slots written since the last upload go to the GPU
    this.until = -Infinity; this.lo = max; this.hi = -1;
  }
  emit(x, y, z, vx, vy, vz, life, s0, s1, now) {
    const k = this.i; this.i = (this.i + 1) % this.max;
    this.pos[k * 3] = x; this.pos[k * 3 + 1] = y; this.pos[k * 3 + 2] = z;
    this.vel[k * 3] = vx; this.vel[k * 3 + 1] = vy; this.vel[k * 3 + 2] = vz;
    this.tl[k * 2] = now; this.tl[k * 2 + 1] = life;
    this.sz[k * 3] = s0; this.sz[k * 3 + 1] = s1; this.sz[k * 3 + 2] = rnd();
    if (k < this.lo) this.lo = k; if (k > this.hi) this.hi = k;
    if (now + life > this.until) this.until = now + life;
    this.points.visible = true;
    this.dirty = true;
  }
  shiftZ(dz) { this.shift(0, dz); }
  shift(dx, dz) { for (let k = 0; k < this.max; k++) { this.pos[k * 3] += dx; this.pos[k * 3 + 2] += dz; } this.lo = 0; this.hi = this.max - 1; this.dirty = true; }
  clear() { for (let k = 0; k < this.max; k++) this.tl[k * 2] = -1e6; this.until = -Infinity; this.lo = 0; this.hi = this.max - 1; this.dirty = true; }
  update(now, scale, fogColor) {
    this.mat.uniforms.uTime.value = now; this.mat.uniforms.uScale.value = scale;
    if (fogColor) this.mat.uniforms.fogColor.value.copy(fogColor);
    this.points.visible = now <= this.until;
    if (this.dirty) {
      const a = this.geo.attributes, lo = this.lo, n = this.hi - lo + 1;
