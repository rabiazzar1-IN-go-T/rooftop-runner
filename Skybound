<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#2a1a2e">
<meta name="mobile-web-app-capable" content="yes">
<title>Skybound</title>
<style>
:root{
  --gold:#ffcf7a; --ember:#ff8a3d; --rust:#a8402a; --ink:#1b1220; --panel:rgba(30,18,34,.62);
  --sat:env(safe-area-inset-top,0px); --sab:env(safe-area-inset-bottom,0px);
  --sal:env(safe-area-inset-left,0px); --sar:env(safe-area-inset-right,0px);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;background:#1b1220;overflow:hidden;overscroll-behavior:none;touch-action:none;
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:#fff;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
#c{position:fixed;inset:0;width:100%;height:100%;display:block}
.screen{position:fixed;inset:0;display:none;flex-direction:column;align-items:center;
  padding:calc(var(--sat) + 16px) calc(var(--sar) + 16px) calc(var(--sab) + 16px) calc(var(--sal) + 16px)}
.screen.on{display:flex}
.serif{font-family:Georgia,"Times New Roman",serif}
/* home */
#home{background:#2a1a2e center/cover no-repeat;justify-content:space-between}
#home::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,10,30,.55) 0%,rgba(20,10,30,0) 30%,rgba(20,10,30,0) 55%,rgba(20,10,30,.75) 100%);pointer-events:none}
.title{position:relative;margin-top:4vh;text-align:center;letter-spacing:.14em;line-height:.95}
.title h1{margin:0;font-weight:700;font-size:min(13vw,64px);color:#fff3dc;
  text-shadow:0 0 18px rgba(255,170,90,.75),0 0 42px rgba(255,120,60,.45),0 3px 0 rgba(90,30,20,.6)}
.title .sub{margin-top:10px;font-size:min(3.4vw,15px);letter-spacing:.42em;color:var(--gold);opacity:.9}
.homebox{position:relative;width:min(100%,420px);display:flex;flex-direction:column;gap:12px;align-items:stretch}
.stats{display:flex;justify-content:center;gap:22px;font-size:15px;color:#ffe9c9;text-shadow:0 1px 4px #000}
.stats b{color:var(--gold);font-size:18px}
.btn{appearance:none;border:0;border-radius:16px;padding:16px 20px;font-size:20px;font-weight:700;letter-spacing:.08em;
  color:#2b130b;background:linear-gradient(180deg,#ffd896,#f39a4a);box-shadow:0 6px 0 #9c4a22,0 10px 24px rgba(0,0,0,.45),inset 0 1px 0 #fff6d8;
  font-family:Georgia,serif;cursor:pointer;touch-action:manipulation}
.btn:active{transform:translateY(3px);box-shadow:0 3px 0 #9c4a22,0 6px 14px rgba(0,0,0,.45)}
.btn.ghost{background:rgba(30,18,34,.55);color:#ffe2b8;box-shadow:inset 0 0 0 1.5px rgba(255,207,122,.55);font-size:16px;padding:12px}
.seg{display:flex;background:rgba(30,18,34,.6);border-radius:12px;padding:4px;box-shadow:inset 0 0 0 1px rgba(255,207,122,.35)}
.seg button{flex:1;border:0;background:transparent;color:#ffe2b8;padding:10px 0;font-size:15px;border-radius:9px;font-weight:600}
.seg button.on{background:linear-gradient(180deg,#ffd896,#f39a4a);color:#2b130b}
.lbl{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#ffd9a8;opacity:.85;text-align:center}
.note{font-size:12px;opacity:.7;text-align:center}
/* hud */
#hud{display:none;position:fixed;left:0;right:0;top:0;padding:calc(var(--sat) + 10px) calc(var(--sar) + 12px) 0 calc(var(--sal) + 12px);
  justify-content:space-between;align-items:flex-start;pointer-events:none;font-family:Georgia,serif}
#hud.on{display:flex}
.score{font-size:30px;font-weight:700;color:#fff6e4;text-shadow:0 2px 6px rgba(0,0,0,.6),0 0 14px rgba(255,160,80,.35);font-variant-numeric:tabular-nums}
.mult{display:inline-block;margin-top:4px;padding:2px 10px;border-radius:10px;background:rgba(30,18,34,.55);color:var(--gold);font-size:16px;font-weight:700;box-shadow:inset 0 0 0 1px rgba(255,207,122,.4)}
.right{display:flex;gap:10px;align-items:center}
.gears{display:flex;align-items:center;gap:6px;padding:4px 12px 4px 6px;border-radius:14px;background:rgba(30,18,34,.55);font-size:22px;font-weight:700;color:#ffe2a8;font-variant-numeric:tabular-nums;box-shadow:inset 0 0 0 1px rgba(255,207,122,.35)}
.gears svg{width:26px;height:26px}
#pauseBtn{pointer-events:auto;width:46px;height:46px;border-radius:14px;border:0;background:rgba(30,18,34,.6);box-shadow:inset 0 0 0 1.5px rgba(255,207,122,.5);display:grid;place-items:center}
#pauseBtn i{display:block;width:5px;height:18px;background:#ffe2b8;border-radius:2px;margin:0 3px}
#pauseBtn span{display:flex}
/* panels */
.dim{background:rgba(15,8,20,.6);justify-content:center;backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}
.panel{width:min(100%,360px);background:linear-gradient(180deg,rgba(58,32,48,.92),rgba(30,18,34,.94));border-radius:22px;padding:22px 18px;
  box-shadow:0 0 0 1.5px rgba(255,207,122,.45),0 20px 60px rgba(0,0,0,.6);display:flex;flex-direction:column;gap:12px;text-align:center}
.panel{max-height:100%;overflow-y:auto;touch-action:pan-y;overscroll-behavior:contain}
.panel h2{margin:0 0 4px;font-family:Georgia,serif;letter-spacing:.12em;color:#ffe6bf;font-size:26px}
.big{font-family:Georgia,serif;font-size:44px;font-weight:700;color:#fff3dc;text-shadow:0 0 18px rgba(255,160,80,.5)}
.row{display:flex;justify-content:space-between;font-size:16px;color:#ffe2b8;padding:0 6px}
#loading{background:#1b1220 center/cover no-repeat;justify-content:flex-end}
.bar{width:min(80%,320px);height:8px;border-radius:5px;background:rgba(255,255,255,.15);overflow:hidden;margin-bottom:12vh;box-shadow:0 0 0 1px rgba(255,207,122,.35)}
.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#ffb45a,#ffe2a0);transition:width .25s}
.ltxt{min-height:18px;margin-bottom:10px;font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:#ffe2b8;text-shadow:0 1px 4px #000;opacity:.85}
.lfail{margin:auto;max-width:340px;padding:20px;border-radius:16px;background:rgba(30,18,34,.85);text-align:center;font-size:16px;line-height:1.45;color:#ffe9c9}
#home{justify-content:space-between}
#home::before{background:linear-gradient(180deg,rgba(20,10,30,.15) 0%,rgba(20,10,30,0) 35%,rgba(20,8,16,.55) 62%,rgba(16,6,12,.88) 100%)}
.logo{position:relative;text-align:center;margin-bottom:22px}
.logo .emblem{position:absolute;left:50%;top:50%;width:min(46vw,200px);transform:translate(-50%,-62%);opacity:.9;filter:drop-shadow(0 0 10px rgba(255,170,80,.45))}
.logo h1{position:relative;margin:0;font-size:min(17vw,84px);font-weight:700;letter-spacing:.01em;line-height:1;
  background:linear-gradient(180deg,#fff3cf 0%,#f0c46a 45%,#b0702a 70%,#ffdf9a 100%);-webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 3px 0 #3a1c0a) drop-shadow(0 0 14px rgba(255,160,70,.55))}
.btn.plate{position:relative;display:flex;align-items:center;justify-content:center;gap:12px;color:#fbe7c0;font-size:28px;letter-spacing:.04em;padding:14px 20px;
  background:linear-gradient(180deg,#4a2a1a,#24120c);border-radius:14px;box-shadow:0 0 0 2px #e0a84a,0 0 0 4px #5a3412,0 0 22px rgba(255,170,80,.5),inset 0 1px 0 rgba(255,220,160,.35);
  text-shadow:0 2px 2px #000}
.btn.plate:active{transform:translateY(2px)}
.btn.plate.small{font-size:20px;padding:10px 16px;width:72%;align-self:center;box-shadow:0 0 0 1.5px #c08a3a,0 0 0 3px #4a2a10,inset 0 1px 0 rgba(255,220,160,.25)}
.tri{width:0;height:0;border-left:20px solid #ffe2a0;border-top:13px solid transparent;border-bottom:13px solid transparent;filter:drop-shadow(0 0 6px rgba(255,190,90,.8))}
.panel label.row{align-items:center;gap:10px}
.panel input[type=range]{width:52%;accent-color:#f0a04a}
.panel input[type=checkbox]{width:22px;height:22px;accent-color:#f0a04a}
.credits{font-size:11px;opacity:.75;line-height:1.4;text-align:left}
#fps{position:fixed;left:calc(var(--sal) + 8px);bottom:calc(var(--sab) + 8px);font:12px monospace;color:#bfffbf;text-shadow:0 1px 2px #000;pointer-events:none;display:none;white-space:pre}
#toast{position:fixed;left:50%;top:38%;transform:translate(-50%,-50%);font-family:Georgia,serif;font-size:28px;font-weight:700;color:#fff1d6;
  text-shadow:0 0 16px rgba(255,140,60,.9),0 2px 4px #000;opacity:0;transition:opacity .25s;pointer-events:none;letter-spacing:.08em;text-align:center}
</style>
</head>
