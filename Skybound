// Inject shared uniforms (and optional extras) into any built-in material.
function patchMaterial(mat, opts = {}) {
  if (!mat || mat.userData.patched) return mat;
  mat.userData.patched = true;
  const prev = mat.onBeforeCompile;
  mat.onBeforeCompile = (sh, r) => {
    if (prev) prev(sh, r);
