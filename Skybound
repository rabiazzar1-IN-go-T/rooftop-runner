// one adaptation step per 1.5 s window while playing: resolution steps, then MSAA off, then (for the next start) a lower
// quality. The limits follow the frame-rate target (at 60: slow above 21.5 ms, holding below 17.5 ms, as before).
function adapt(avg, span) {
  // (never aim below 60: a phone that only manages 45 fps would otherwise measure "45 Hz" and stop adapting)
  const T = 1 / targetHz(), aim90 = T < 1 / 70;
  if (avg > T * 1.29) {
    fastAcc = 0;
    if (aim90 && dynScale <= 0.71) {
      // 90 would need a soft picture: settle for a smooth 60 at a sharper one (MSAA back, a step up in resolution)
      fps90Off = true; post.setSamples(post.maxSamples);
      dynScale = Math.min(1, Math.round((dynScale + 0.2) * 100) / 100); resize();
    } else if (dynScale > 0.81 || (post.samples > 0 && dynScale > DYN_MIN)) {
      // at 0.8 the picture is already softer: dropping the MSAA resolve first saves more than another resolution step
      if (post.samples > 0 && dynScale <= 0.81) post.setSamples(0);
      else { dynScale = Math.max(DYN_MIN, Math.round((dynScale - 0.1) * 100) / 100); resize(); }
    } else if (targetHz() > 31) {
      // the picture stays sharp: take the next even, slower rate instead (60 -> 40 -> 30 on a 120 Hz screen)
      paceCap = targetHz() - 2; slowWins = 0; // (-2: the +1 tolerance in targetHz must not let the same rate through)
    } else if (dynScale > DYN_MIN) { dynScale = Math.max(DYN_MIN, Math.round((dynScale - 0.1) * 100) / 100); resize(); }
  } else if (avg < T * 1.05 && dynScale < 1) {
    fastAcc += span;
    if (fastAcc > 6) { dynScale = Math.min(1, Math.round((dynScale + 0.05) * 100) / 100); resize(); fastAcc = 0; }
  } else if (avg >= T * 1.05) fastAcc = 0;
  // still below 40 fps at the lowest resolution for about 12 s: the next start uses one quality lower
  // (never mid-run: the quality decides render targets, shadows, textures and shaders at load)
  if (!aim90 && dynScale <= DYN_MIN + 0.001 && avg > T * 1.29) slowWins++; else if (avg < T * 1.1) slowWins = 0;
  if (slowWins >= 8 && !Game.autoQ && settings.qualityAuto && Q.name !== 'low') {
    Game.autoQ = Q.name === 'high' ? 'medium' : 'low';
    store.set('quality', Game.autoQ); store.set('qualityAuto', true);
  }
}
function tick(rdt) {
  renderer.info.reset();
  const dt = rdt * Game.timeScale;
  Game.realTime += rdt;
  if (Game.state === 'playing') {
    Game.time += dt; U.uTime.value = Game.time;
    updatePlayer(dt);
    Sound.setIntensity(Game.difficulty); Sound.wind(0.35 + Game.difficulty * 0.4);
    updateHUD();
  } else if (Game.state === 'dying') {
    Game.time += dt; U.uTime.value = Game.time;
    Game.speed = damp(Game.speed, 0, 3, dt); Game.dist = Math.min(Game.dist + Game.speed * dt, World.wallLimit());
    chase.zOff = damp(chase.zOff, 0.9, 3, dt);
    Game.dieT -= rdt; if (Game.dieT <= 0) gameOver();
  } else if (Game.state === 'over') {
    Game.time += dt * 0.3; U.uTime.value = Game.time;
  }
  World.update(dt, Game.dist, rdt);
  Runner.update(dt, P, Game.speed);
  Hound.update(dt, P, chase, Game.speed);
  updateCamera(rdt);
  updateLighting();
  World.placeSky(camera);
  for (const m of LIVE) m.update(dt, rdt);
  World.motes.mat.uniforms.uTime.value = Game.realTime; World.motes.mat.uniforms.uScroll.value = Game.dist; World.motes.mat.uniforms.uScale.value = pScale;
  World.motes.mat.uniforms.uCenter.value.set(camera.position.x, 1.5, -12);
  if (Street.leaves) {
    const lu = Street.leaves.mat.uniforms; lu.uTime.value = Game.realTime; lu.uScroll.value = Game.dist; lu.uScale.value = pScale;
    lu.uCenter.value.set(camera.position.x, 2.2, -14);
  }
  const fc = scene.fog.color;
  for (const p of World.parts) p.update(Game.time, pScale, fc);
  post.params.slowmo = damp(post.params.slowmo, Game.timeScale < 0.9 ? 1 : 0, 6, rdt);
  post.render(scene, camera, Game.realTime);
}

// ---------- boot ----------
// give the browser a turn between the long loading steps, so the loading bar can paint: after a long task Chrome runs
// the overdue frame first. A message task, not a timer or a frame wait: it costs nothing when no frame is due and is
// not slowed down in a background tab.
function yieldPaint() {
  return new Promise((res) => { const ch = new MessageChannel(); ch.port1.onmessage = () => res(); ch.port2.postMessage(0); });
}
// compile every shader (hidden objects too) for the target the scene is really drawn into: with post-processing that
// is the linear HDR target, not the screen (compiling for the screen built a second, never used set of ~50 shaders).
// Parallel where the phone allows it. (The "hound in view" variants come from Hound.prewarm.)
function warmShaders() {
  renderer.setRenderTarget(Q.post ? post.sceneRT : null);
  const p = renderer.compileAsync(scene, camera);
  renderer.setRenderTarget(null);
  return p;
}
function freeAssets() {
  // every texture and model has loaded by now: drop the ~11 MB of embedded base64 and the script text that held it
  for (const k in A) delete A[k];
  const s = document.getElementById('assets'); if (s) s.textContent = '';
  window.__assetsFreed = true;
}
async function boot() {
  const bar = $('loadbar'), ltxt = $('loadtxt');
  const homeArt = A['img/home.jpg'] || A['img/title.jpg'];
  if (homeArt) { $('loading').style.backgroundImage = `url(${homeArt})`; $('home').style.backgroundImage = `url(${homeArt})`; }
  // remember how the environment light is made, so it can be rebuilt after a graphics loss
  const fromScene = THREE.PMREMGenerator.prototype.fromScene;
  THREE.PMREMGenerator.prototype.fromScene = function (...args) { if (!envSrc) envSrc = args; return fromScene.apply(this, args); };
  const steps = [() => World.init(scene, renderer), () => Runner.init(scene), () => Hound.init(scene), ...LIVE.map((m) => () => m.init(scene))];
  const total = steps.length + 1;
  const mark = (n) => { try { performance.mark('boot:' + n); } catch (e) { /* old browser */ } }; // boot timing, read with ?fps
  try {
    for (let i = 0; i < steps.length; i++) { await steps[i](); mark('step' + i); bar.style.width = ((i + 1) / total) * 100 + '%'; await yieldPaint(); }
  } finally { THREE.PMREMGenerator.prototype.fromScene = fromScene; }
  // textures still arriving (a material that gets its map later would need a second shader mid-run)
  await Promise.all(Array.from(_texCache.values(), (p) => Promise.resolve(p).catch(() => null)));
  mark('textures');
  ltxt.textContent = 'Preparing graphics';
  await yieldPaint();
  resize();
  resetRun();
  // warm up: compile every shader before the first real frame (avoids a hitch when the run starts)
  World.update(0, 0); Runner.update(0, P, SPEED0); Hound.update(0, P, chase, SPEED0); updateCamera(0.016); updateLighting(); World.placeSky(camera);
  mark('prewarm');
  await warmShaders();
  mark('compiled');
  post.render(scene, camera, 0);
  mark('warmFrame');
  bar.style.width = '100%';
  if (DEBUG) { $('fps').style.display = 'block'; window.__g = { World, Game, camera, scene, renderer, post, P, Runner, Hound, U, THREE, chase, Input, stumble, LIVE, Street, settings, resize, frame, // frame(now): drive the real loop with test timestamps
    pace: () => ({ refreshMs, targetHz: targetHz(), fps90Off, dynScale, samples: post.samples }),
    step: (n, dt = 1 / 60) => { for (let i = 0; i < n; i++) tick(dt); } }; }
  show('loading', false);
  window.__booted = true;
  freeAssets();
  const auto = /[?&]autoplay/.test(location.search);
  if (auto) startRun(); else goHome();
  requestAnimationFrame(frame);
}
boot().catch((e) => {
  console.error(e);
  if (window.__bootFail) window.__bootFail(e && e.message ? e.message : String(e));
  else $('loading').innerHTML = '<div style="margin:auto;padding:20px;text-align:center">Could not start: ' + (e && e.message ? e.message : e) + '</div>';
});


</script>
