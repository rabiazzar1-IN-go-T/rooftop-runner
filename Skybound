// one street section. Built 1 m long and stretched to each section's length as an instance (world-space texturing
// does not stretch), so all the sections share one road, one pavement and one stone draw.
function streetGeos(L, ex = 0.02) {
  const road = [], walk = [], stone = [];
  pushQuad(road, [-ROAD_HALF, 0, ex], [ROAD_HALF, 0, ex], [ROAD_HALF, 0, -L - ex], [-ROAD_HALF, 0, -L - ex]);
  // right gutter strip up to the parapet
